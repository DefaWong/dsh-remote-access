{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rewriteRelativeImportExtensions": true,
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "types": [
      "node"
    ],
    "rootDir": "src",
    "outDir": "lib",
    "declaration": false,
    "sourceMap": false
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/client"
  ]
}
